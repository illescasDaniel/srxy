# Local-only signing config for packaging/macos/sign-release.sh.
#
# Copy this file to packaging/macos/signing/signing.env (gitignored) and fill it
# in. Place your exported Developer ID Application certificate (.p12) next to it
# under packaging/macos/signing/ too. Nothing in packaging/macos/signing/ is ever
# read by CI or committed to git.
#
# Steps to produce the values below:
#   1. In Xcode > Settings > Accounts > (your team) > Manage Certificates, create
#      a "Developer ID Application" certificate, then export it from Keychain
#      Access as a .p12 (set a password when exporting).
#   2. Set up a notarytool keychain profile once (stores credentials in your
#      login keychain, not on disk):
#        xcrun notarytool store-credentials srxy-notary \
#          --apple-id "you@example.com" \
#          --team-id "TEAMID1234" \
#          --password "an app-specific password from appleid.apple.com"

# Exact signing identity string, as shown by `security find-identity -v -p codesigning`.
SRXY_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# Filename of the .p12, relative to packaging/macos/signing/.
SRXY_SIGNING_P12="developer-id.p12"

# Password used when exporting the .p12 from Keychain Access.
SRXY_SIGNING_P12_PASSWORD="changeme"

# notarytool keychain profile name set up via `xcrun notarytool store-credentials`.
SRXY_NOTARY_PROFILE="srxy-notary"
